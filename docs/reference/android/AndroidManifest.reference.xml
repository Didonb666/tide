<?xml version="1.0" encoding="utf-8"?>
<!--
  android/app/src/main/AndroidManifest.xml（节选：与隧道相关的部分）

  Android 14+ 注意：
    - targetSdk >= 34 时前台服务必须声明 type；VPN 没有专属 type，
      通行做法是 specialUse + PROPERTY_SPECIAL_USE_FGS_SUBTYPE=vpn。
    - 不要申请 REQUEST_IGNORE_BATTERY_OPTIMIZATIONS（Play 政策限制），
      改为引导用户去系统设置页。
    - BOOT_COMPLETED 无法在 Android 12+ 拉起前台服务；开机自连请引导用户开启 Always-on VPN。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 分应用代理需要枚举已安装应用；Play 需提交 QUERY_ALL_PACKAGES 用途声明。
         若不做分应用，删除该权限，改用下面的 queries 仅列出可启动应用。 -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission"
        xmlns:tools="http://schemas.android.com/tools" />

    <application
        android:name=".TideApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tide"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".tunnel.TunnelService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">

            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>

            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
        </service>

        <queries>
            <intent>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent>
        </queries>
    </application>
</manifest>
